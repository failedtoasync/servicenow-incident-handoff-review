<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sys_script_client">
    <sys_script_client action="DELETE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Prevents completion or manual cancellation of an IHR when eview notes field is empty.</description>
        <field>review_status</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>IHR - Validate Review Notes</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }

    //Type appropriate comment here, and begin script below
	alert(newValue);

    if (newValue == 'completed' || newValue == 'cancelled') {

        var notes = g_form.getValue('review_notes');
        g_form.addInfoMessage('running 1');
        if (!notes.trim()) {

            g_form.setMandatory('review_notes', true);
            g_form.addInfoMessage('running 2');

            g_form.showFieldMsg(
                'review_notes',
                'Review Notes are required.',
                'error'
            );
            g_form.addInfoMessage('running 3');

            g_form.addErrorMessage(
                'Review Notes are required before completing or cancelling the review.'
            );
            g_form.addInfoMessage('running 4');

            g_form.setValue('review_status', oldValue);
        }
    }

    g_form.addInfoMessage('running 5');


}]]></script>
